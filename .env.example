# =====================================================================
# UMaT SRC Cashless Payment - environment variables
# LOCAL: put these in .env.local (git-ignored).
# VERCEL: add each one under Project > Settings > Environment Variables,
#         pasting the value WITHOUT quotes.
# =====================================================================

# --- Database (Neon) - REQUIRED ---
# Neon dashboard > Connection Details > use the POOLED connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth - REQUIRED ---
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Same public address students use, no trailing slash. Used for login,
# the Paystack return page and receipt/verification links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- Encryption of stored Paystack / Arkesel keys - REQUIRED ---
# Paystack keys and the subaccount are saved from the Super Admin
# dashboard (encrypted in Neon), NOT in this file.
# Generate: openssl rand -base64 32   (must decode to exactly 32 bytes)
# Never change it after saving keys, or the saved keys become unreadable.
ENCRYPTION_KEY=

# --- First Super Admin (one-time seed: npm run prisma:seed) - REQUIRED ONCE ---
# The seed only CREATES these accounts. Re-running it never resets a password.
SRC_SUPER_ADMIN_EMAIL=
SRC_SUPER_ADMIN_PASSWORD=
# Optional first day-to-day Admin (more can be added in the dashboard)
SRC_ADMIN_EMAIL=
SRC_ADMIN_PASSWORD=

# --- SMS (Arkesel) - optional ---
# Value must be ARKESEL (any letter case works). Leave empty = SMS only logged.
# The Arkesel API key and sender ID are saved in the dashboard, not here.
SMS_PROVIDER=ARKESEL

# --- Email (Brevo) - optional ---
# Value must be BREVO (any letter case works). Leave empty = email only logged.
EMAIL_PROVIDER=BREVO
EMAIL_API_KEY=
# Must be a sender you verified in Brevo (Senders, Domains & Dedicated IPs).
EMAIL_FROM_ADDRESS=
# Quote this one - it contains spaces.
EMAIL_FROM_NAME="UMaT SRC"

# --- Scheduled payment reconcile - REQUIRED in production ---
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- Monitoring - optional ---
SENTRY_DSN=
