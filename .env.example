# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Generate with: openssl rand -base64 32 (must decode to exactly 32 bytes)
ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
NEXT_PUBLIC_APP_URL="https://payment-src.com"
SRC_SUPER_ADMIN_EMAIL="superadmin@example.com"
SRC_SUPER_ADMIN_PASSWORD="replace-with-at-least-12-characters"
# Optional initial regular administrator
SRC_ADMIN_EMAIL="admin@example.com"
SRC_ADMIN_PASSWORD="replace-with-at-least-12-characters"
